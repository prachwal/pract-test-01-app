{
  "name": "pract-test-01-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "postcss:info": "npx autoprefixer --info",
    "postcss:test": "node -e \"console.log('PostCSS config loaded successfully')\"",
    "postcss:browsers": "echo 'Checking browser support...' && npx autoprefixer --info | head -5",
    "test:e2e": "playwright test",
    "test:unit": "vitest run"
  },
  "dependencies": {
    "@preact/signals": "^2.5.0",
    "preact": "^10.27.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@preact/preset-vite": "^2.10.2",
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "^4.0.9",
    "autoprefixer": "^10.4.22",
    "dotenv": "^17.2.3",
    "jsdom": "^27.2.0",
    "postcss": "^8.5.6",
    "sass": "^1.94.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.2",
    "vitest": "^4.0.9"
  }
}
